# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://bingoplus:bingoplus_dev@localhost:55432/bingoplus?schema=public"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN="http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005"

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Maps / Delivery (Phase 4) ────────────────────────────────────────────────
# Leave empty (or "mock") in development/test — MapModule falls back to MockMapProvider
# automatically. Boot fails on purpose if NODE_ENV=production and this is still empty/"mock" — a
# real provider must be configured before going live, same rule as PAYMENT_PROVIDER.
MAP_PROVIDER=
GOOGLE_MAPS_API_KEY=
# How often (ms) a Rider app should push a location update during an active delivery.
LOCATION_UPDATE_INTERVAL=15000
# How long (seconds) a Rider has to accept/reject an assigned delivery before DispatchService
# reassigns it to another Rider (§22) — also seeded as RiderDispatchConfig.assignmentTimeoutSeconds.
RIDER_ASSIGNMENT_TIMEOUT=60

# ── Social login (leave empty to disable) ────────────────────────────────────
# Google is fully wired (backend strategy/guard/routes + a button on every app's login/register).
# Apple isn't built yet — these three vars are unused placeholders until that happens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Where GET /auth/google/callback sends the browser back to, per originating app — see the `app`
# query param on GET /auth/google, threaded through Google's own `state` round-trip. Each already
# defaults to its local dev port in code; only needed here to point at a deployed URL instead.
CUSTOMER_APP_URL=
RIDER_APP_URL=
BUSINESS_APP_URL=
ADMIN_APP_URL=

# ── Payments (Phase 3) ───────────────────────────────────────────────────────
# Leave PAYMENT_PROVIDER empty (or "sandbox") in development/test — the API falls back to
# SandboxPaymentProvider automatically. Boot fails on purpose if NODE_ENV=production and this is
# still empty/"sandbox" — a real provider must be set before going live.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
# HMAC key SandboxPaymentProvider uses to verify POST /payments/webhooks/:provider — required for
# that endpoint to accept anything; a real provider's own webhook secret replaces this later.
PAYMENT_WEBHOOK_SECRET=
# MVP is USD-only, but every price is stored per-record, not hardcoded — changing this alone
# doesn't add a second currency, see docs/15-fase3-marketplace-checkout-payments.md §11.
CURRENCY=USD

# ── Storage (S3-compatible) ───────────────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ── Notifications ─────────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in development — EmailModule falls back to SandboxEmailProvider
# automatically (logs the email instead of sending it), same "sandbox when unconfigured" shape as
# PAYMENT_PROVIDER/MAP_PROVIDER. Powers password-reset emails and the email-verification code.
EMAIL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=BINGO+
# BINGO+'s own signature block on every business contract PDF — placeholder until the real legal
# representative name/RUC are supplied.
BINGOPLUS_LEGAL_REPRESENTATIVE_NAME=Representante Legal BINGO+ (dato de prueba)
BINGOPLUS_LEGAL_RUC=9999999999001
SMS_API_KEY=
PUSH_NOTIFICATION_KEY=

# ── Analytics (optional) ──────────────────────────────────────────────────────
ANALYTICS_PROVIDER=
ANALYTICS_KEY=

# ── apps/admin (frontend) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# ── apps/business and apps/rider (frontend) ────────────────────────────────────
# Both share their account/password with Customer, so "¿Olvidaste tu contraseña?" on their login
# pages links out to the Customer app's own /forgot-password page instead of duplicating the flow.
NEXT_PUBLIC_CUSTOMER_APP_URL="http://localhost:3002"
