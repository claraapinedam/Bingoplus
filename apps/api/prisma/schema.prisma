// BINGO+ database schema.
// Human-readable index of every table: docs/04-database-schema.md
// Relationship diagrams: docs/03-database-erd.md

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Only used by the Migrate engine (migrate deploy/dev) — the generated Client always talks to
  // DATABASE_URL. Needed for providers that put a transaction-mode pooler (no prepared statement
  // support) in front of Postgres, e.g. Supabase's pgbouncer pooler — DIRECT_URL should point at
  // a non-pooled or session-mode connection instead. Safe to leave unset for a plain Postgres
  // instance (e.g. local Docker): Prisma falls back to DATABASE_URL for migrations too.
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

// ───────────────────────────── Identity (Phase 1) ─────────────────────────────

enum RoleName {
  SUPER_ADMIN
  ADMIN
  // Restricted admin-panel account: can log into the Admin app and use everything except
  // Analytics and Settings (ranking weights / pricing) — see AdminAnalyticsController and
  // AdminSettingsController, the only two admin controllers that deliberately never add USER to
  // their @Roles(...) allow-list. Unrelated to CUSTOMER (a marketplace shopper).
  USER
  BUSINESS_OWNER
  BUSINESS_MANAGER
  RIDER
  CUSTOMER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String?
  firstName       String
  lastName        String
  avatarUrl       String?
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  // Populated once Phase 8's reviews module lets a business/rider rate a customer after an
  // order (ReviewTargetType.CUSTOMER below) — honestly 0 until then, never a fabricated number.
  ratingAvg       Float     @default(0)
  reviewCount     Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles                      UserRole[]
  addresses                  Address[]
  pets                       Pet[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  otpCodes                   OtpCode[]
  ownedBusinesses            Business[]              @relation("BusinessOwner")
  businessUsers              BusinessUser[]
  rider                      Rider?
  cart                       Cart?
  paymentMethods             PaymentMethod[]
  orders                     Order[]
  bookings                   Booking[]
  reviews                    Review[]
  reviewReports              ReviewReport[]
  favorites                  Favorite[]
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  auditLogs                  AuditLog[]
  analyticsEvents            AnalyticsEvent[]
  documentsReviewed          BusinessDocument[]      @relation("DocumentReviewer")
  couponRedemptions          CouponRedemption[]      @relation("CouponRedeemer")
  submittedPetFriendlyPlaces PetFriendlyPlace[]      @relation("PetFriendlyPlaceSubmitter")
  reviewedPetFriendlyPlaces  PetFriendlyPlace[]      @relation("PetFriendlyPlaceReviewer")
  supportCases               SupportCase[]           @relation("SupportCaseSubmitter")
  supportCaseResponses       SupportCaseResponse[]   @relation("SupportCaseResponseAuthor")
  supportChats               SupportChat[]           @relation("SupportChatSubmitter")
  assignedSupportChats       SupportChat[]           @relation("SupportChatAssignedAdmin")
  supportChatMessages        SupportChatMessage[]    @relation("SupportChatMessageSender")
  deliveryChatMessages       DeliveryChatMessage[]   @relation("DeliveryChatMessageSender")

  @@index([email])
  @@index([phone])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  VERIFY_EMAIL
}

model OtpCode {
  id          String     @id @default(cuid())
  userId      String?
  destination String
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destination, purpose])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String
  line1      String
  line2      String?
  city       String
  state      String?
  country    String   @default("EC")
  postalCode String?
  latitude   Float?
  longitude  Float?
  // "Referencias / indicaciones para la entrega" — free text, not structured, since we have no
  // real geocoding/map picker wired yet (that's Phase 4, GOOGLE_MAPS_API_KEY).
  notes      String?
  // Parroquia — free text for now (unlike city/state, which are picklists backed by the official
  // INEC province/cantón list); the parish level is the most error-prone to keep as static data
  // and isn't used for real delivery zoning yet.
  parish     String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ───────────────────────────── Pets (Phase 1) ─────────────────────────────

// Admin-manageable lookup (docs/08 §Admin panel), not a hardcoded enum, so new species can be
// added without a migration. Drives both a pet's own species and which species a product targets
// — the join between those two is what BusinessRankingService matches on.
model PetSpecies {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  icon String?

  pets       Pet[]
  products   ProductSpecies[]
  services   ServiceSpecies[]
  businesses BusinessSpecies[]
}

model Pet {
  id              String    @id @default(cuid())
  ownerId         String
  name            String
  speciesId       String
  breed           String?
  sex             String?
  birthDate       DateTime?
  weight          Float?
  photoUrl        String?
  allergies       String[]  @default([])
  foodPreferences String[]  @default([])
  medicalNotes    String?
  veterinarian    String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species           PetSpecies         @relation(fields: [speciesId], references: [id])
  bookings          Booking[]
  couponRedemptions CouponRedemption[]

  @@index([ownerId])
  @@index([speciesId])
}

// ───────────────────────────── Directory (Phase 1 onboarding, Phase 2 catalog) ─────────────────────────────

enum BusinessStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
}

// Business.manualOverride — the business's own connect/disconnect toggle, entirely separate from
// BusinessStatus above (account standing, admin-controlled). Two values only, never a third
// "AUTO" member: "follow the schedule" is represented by the field being null, not by a value of
// this enum, so "no override" and "override" can never both make sense to store at once.
enum BusinessOnlineOverride {
  ONLINE
  OFFLINE
}

model BusinessCategory {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  icon String?

  businesses BusinessCategoryLink[]
}

enum BusinessIdType {
  RUC
  CEDULA
}

enum BusinessBankAccountType {
  SAVINGS
  CHECKING
}

model Business {
  id                    String                                 @id @default(cuid())
  ownerId               String
  tradeName             String
  // RUC: legalName is the "Razón Social". CEDULA: legalName is just the person's own name —
  // representativeName is only meaningful (and collected) for RUC, where a company signs through
  // a named legal representative rather than being the natural person itself.
  idType                BusinessIdType                         @default(RUC)
  legalName             String
  representativeName    String?
  taxId                 String
  email                 String
  phone                 String
  // Required at application time (§ contrato de afiliación real, Anexo Comercial numeral 4 — la
  // liquidación quincenal se paga por depósito/transferencia a esta cuenta). Nullable in the
  // schema only because it postdates existing rows; BusinessesService.apply enforces it for every
  // new application via ApplyBusinessDto.
  bankName              String?
  bankAccountType       BusinessBankAccountType?
  bankAccountNumber     String?
  bankAccountHolderName String?
  description           String?
  logoUrl               String?
  coverImageUrl         String?
  addressLine           String
  city                  String
  latitude              Float?
  longitude             Float?
  location              Unsupported("geography(Point, 4326)")?
  openingHours          Json?
  // FASE 9 §3 — IANA zone (e.g. "America/Guayaquil"), never inferred. Defaulted rather than
  // nullable so every date computed against this business (availability, bookings, reminders,
  // promotions) always has an unambiguous zone instead of silently falling back to server time.
  timezone              String                                 @default("America/Guayaquil")
  // Connect/disconnect toggle (business-self-service, unrelated to `status` below which is
  // admin-controlled account standing). null = "sigue el horario automáticamente" — effective
  // online/offline is computed on read as: manualOverride if set, else getOpeningStatus(openingHours)
  // via getBusinessOnlineStatus() in @bingoplus/utils. A manual override PERSISTS until the business
  // explicitly changes it again (including an explicit "volver a automático" action that resets this
  // to null) — it does NOT auto-expire at the next schedule boundary or at end of day. Chosen over
  // auto-expiry because it's the simpler, more predictable contract: "off means off until you say
  // otherwise" avoids a business believing they're still closed/open only to have it silently flip
  // under them at a boundary they didn't watch for.
  manualOverride        BusinessOnlineOverride?
  // When manualOverride was last set (including to null, i.e. the moment "volver a automático" was
  // pressed) — informational only, nothing currently computes off of it, but every other manual
  // state change in this codebase keeps a timestamp (e.g. BusinessDocument.reviewedAt) so this
  // doesn't stay silent about when a business took control away from the schedule.
  manualOverrideAt      DateTime?
  status                BusinessStatus                         @default(PENDING)
  ratingAvg             Float                                  @default(0)
  reviewCount           Int                                    @default(0)
  deletedAt             DateTime?
  createdAt             DateTime                               @default(now())
  updatedAt             DateTime                               @updatedAt

  // `ownerId` above is the denormalized legal/primary owner (kept for quick reads and the
  // onboarding record); actual access control reads from `businessUsers` (BusinessUser), which
  // is the real source of truth and also covers BUSINESS_MANAGER staff — see
  // docs/08-roles-permissions.md and BusinessOwnershipGuard.
  owner                       User                         @relation("BusinessOwner", fields: [ownerId], references: [id])
  // Multi-select (§ "¿Qué quieres hacer en BINGO+?" restricts which categories are offerable: only
  // "tiendas" when selling products alone, any non-product category for Directory-only, or a mix
  // of both when the business does both) — see BusinessesService.apply's category validation.
  categories                  BusinessCategoryLink[]
  documents                   BusinessDocument[]
  contracts                   BusinessContract[]
  // Declared at onboarding ("¿A qué mascotas aplica tu negocio?") — the species-match signal for
  // BusinessRankingService that doesn't depend on the business having any products/services yet,
  // which matters most for Directory-only businesses (groomers, vets, hotels) that may have none.
  species                     BusinessSpecies[]
  products                    Product[]
  services                    Service[]
  commissions                 Commission[]
  carts                       Cart[]
  orders                      Order[]
  bookings                    Booking[]
  payouts                     Payout[]
  capabilities                BusinessCapability[]
  businessUsers               BusinessUser[]
  membership                  BusinessMembership?
  businessCoupons             BusinessCoupon[]
  couponRedemptions           CouponRedemption[]
  promotions                  Promotion[]
  availabilityBlocks          AvailabilityBlock[]
  commissionCouponRedemptions CommissionCouponRedemption[]
  supportCases                SupportCase[]
  supportChats                SupportChat[]

  @@index([ownerId])
  @@index([status])
}

model BusinessSpecies {
  businessId String
  speciesId  String

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  species  PetSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([businessId, speciesId])
  @@index([speciesId])
}

// Business<->BusinessCategory, same shape as BusinessSpecies above.
model BusinessCategoryLink {
  businessId String
  categoryId String

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
}

enum ContractStatus {
  PENDING_SIGNATURE
  SIGNED
  // Replaced by a newer signed contract after a capability change (e.g. a Tienda-only business
  // adding Directory) — kept forever for audit visibility, just no longer the governing one.
  SUPERSEDED
}

// Created automatically the moment Admin approves a business (BusinessesService.approve) —
// nothing goes ACTIVE (visible in Marketplace/Directory) until this is signed. Snapshots the
// signer identity at creation time rather than reading live off Business, so a later profile
// edit never silently rewrites what was actually agreed to and signed.
model BusinessContract {
  id                          String         @id @default(cuid())
  businessId                  String
  status                      ContractStatus @default(PENDING_SIGNATURE)
  idType                      BusinessIdType
  legalName                   String
  representativeName          String?
  taxId                       String
  // Which capabilities this contract's terms actually cover — the signal used to detect drift
  // when Admin later enables a capability the business's currently-governing contract doesn't
  // cover yet, and what gets applied (via ContractsService.sign) once the new one is signed.
  sellsProducts               Boolean        @default(false)
  directoryListing            Boolean        @default(false)
  // Frozen at contract-generation time — the actual figures this contract's fee clause quotes.
  // Admin's "current commission rate" or a MembershipPlan's price can keep changing after this
  // moment (a new Commission row from a later re-approval, an edited plan price); this is the
  // read-only "photo" of what THIS business actually agreed to, never recomputed from those live
  // tables once written, exactly the way it should never change without a newly-signed contract.
  commissionRatePercent       Decimal?       @db.Decimal(5, 2)
  membershipPlanName          String?
  membershipPriceUsd          Decimal?       @db.Decimal(10, 2)
  membershipBillingFrequency  String?
  // Same "frozen photo" reasoning as the fee fields above, extended to every other placeholder the
  // real contract text (see ContractTemplateService's BUSINESS default) substitutes at generation
  // time — a later edit to Business.tradeName/addressLine/bankAccountNumber, or to
  // PlatformLegalInfo, must never rewrite what a specific signed contract actually says.
  businessTradeName           String?
  businessAddressLine         String?
  bankName                    String?
  bankAccountType             String?
  bankAccountNumber           String?
  bankAccountHolderName       String?
  bingoPlusLegalName          String?
  bingoPlusTaxId              String?
  bingoPlusAddress            String?
  bingoPlusRepresentativeName String?
  bingoPlusSignatureImageUrl  String?
  contractText                String
  // Raw base64 PNG from the signature canvas — kept alongside the rendered PDF as the primary
  // audit artifact of what was actually drawn.
  signatureDataUrl            String?
  signedAt                    DateTime?
  signedIp                    String?
  pdfUrl                      String?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// Which capabilities a business has, independent of its category (RULE 2/3 — see
// docs/... marketplace-vs-directory design). Marketplace eligibility = SELLS_PRODUCTS;
// Directory eligibility = DIRECTORY_LISTING (+ membership visibility rules).
enum BusinessCapabilityType {
  SELLS_PRODUCTS
  DIRECTORY_LISTING
  SERVICES
  BOOKINGS
  PICKUP
  DELIVERY
  COUPONS
  // Directory-only (never applicable to a "Tiendas" business) — the provider travels to the
  // customer's home instead of the customer coming to the business. Gated the same way as
  // SERVICES/BOOKINGS/COUPONS: only assignable while DIRECTORY_LISTING is enabled, and cascades
  // off with it. See Service.locationType for the per-service refinement this unlocks.
  HOME_SERVICE
}

model BusinessCapability {
  id         String                 @id @default(cuid())
  businessId String
  capability BusinessCapabilityType
  enabled    Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, capability])
  @@index([businessId])
  @@index([capability])
  @@index([enabled])
}

enum BusinessUserRole {
  OWNER
  MANAGER
}

// The real access-control edge between a User and a Business — see the Business.ownerId comment above.
model BusinessUser {
  id         String           @id @default(cuid())
  businessId String
  userId     String
  role       BusinessUserRole
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

enum BusinessDocumentType {
  RUC
  ID
  BANK_ACCOUNT
  LICENSE
  CONTRACT
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model BusinessDocument {
  id         String               @id @default(cuid())
  businessId String
  type       BusinessDocumentType
  fileUrl    String
  status     DocumentStatus       @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime             @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer User?    @relation("DocumentReviewer", fields: [reviewedBy], references: [id])

  @@index([businessId])
}

// ───────────────────────────── Catalog (Phase 2) ─────────────────────────────

model ProductCategory {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  icon String?

  products Product[]
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

// Ecuador SRI VAT classification: STANDARD is taxed at the current general rate
// (PricingConfiguration.defaultTaxPercent — 15% today, but has changed before by presidential
// decree, so it's a config value, never hardcoded); ZERO covers products the law exempts (e.g.
// many food staples, medicines). The rate itself lives on PricingConfiguration precisely so a
// rate change never requires reclassifying the catalog — only the category per product does.
enum ProductTaxCategory {
  STANDARD
  ZERO
}

model Product {
  id          String             @id @default(cuid())
  businessId  String
  categoryId  String
  name        String
  description String?
  price       Decimal            @db.Decimal(12, 2)
  salePrice   Decimal?           @db.Decimal(12, 2)
  sku         String?
  stock       Int                @default(0)
  weight      Float?
  images      String[]           @default([])
  status      ProductStatus      @default(ACTIVE)
  taxCategory ProductTaxCategory @default(STANDARD)
  // Phase 8: derived exclusively from Review aggregation (ReviewsService.recomputeAggregate),
  // same discipline as Business/Rider/User — never written to directly.
  ratingAvg   Float              @default(0)
  reviewCount Int                @default(0)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   ProductCategory     @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  movements  InventoryMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  species    ProductSpecies[]

  @@index([businessId])
  @@index([categoryId])
  @@index([status])
}

// Which pet species a product is recommended for (a product can target several) — the signal
// BusinessRankingService reads to compute how relevant a business is to a customer's pets.
model ProductSpecies {
  productId String
  speciesId String

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  species PetSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([productId, speciesId])
  @@index([speciesId])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  name       String
  sku        String  @unique
  priceDelta Decimal @default(0) @db.Decimal(12, 2)
  stock      Int     @default(0)

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements  InventoryMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

enum InventoryReason {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

model InventoryMovement {
  id             String          @id @default(cuid())
  productId      String
  variantId      String?
  quantityChange Int
  reason         InventoryReason
  note           String?
  createdAt      DateTime        @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
}

// ───────────────────────────── Commerce (Phase 2 cart, Phase 3 checkout) ─────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  userId     String   @unique
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business   @relation(fields: [businessId], references: [id])
  items    CartItem[]

  @@index([businessId])
}

model CartItem {
  id                String  @id @default(cuid())
  cartId            String
  productId         String
  variantId         String?
  quantity          Int
  unitPriceSnapshot Decimal @db.Decimal(12, 2)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

// §16/§67 (Phase 4): Order state and Delivery state are deliberately separate domains — the
// granular logistics states (searching a rider, picked up, in transit, delivered...) live on
// Delivery.status, not here. A DELIVERY order sits at READY_FOR_PICKUP for the entire delivery
// lifecycle and only moves to COMPLETED once DeliverySyncService observes Delivery.status =
// DELIVERED. This enum used to also carry SEARCHING_RIDER/RIDER_ASSIGNED/PICKED_UP/IN_TRANSIT/
// DELIVERED as placeholders from the Phase 2 schema design, but nothing ever transitioned into
// them (see git history) — removed rather than left as confusing dead states.
enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

model Order {
  id                      String          @id @default(cuid())
  orderNumber             String          @unique
  userId                  String
  businessId              String
  addressId               String?
  fulfillmentType         FulfillmentType
  status                  OrderStatus     @default(CREATED)
  subtotal                Decimal         @db.Decimal(12, 2)
  discount                Decimal         @default(0) @db.Decimal(12, 2)
  // Customer-facing fee lines (§9/24) — distinct from Commission/BusinessContract, which is what
  // BINGO+ takes from the business's own payout, never an extra amount charged to the customer.
  serviceFee              Decimal         @default(0) @db.Decimal(12, 2)
  deliveryFee             Decimal         @default(0) @db.Decimal(12, 2)
  // "subtotalIva" / "subtotalIva0" in Ecuador SRI/Kushki terms — the split of `subtotal` (net of
  // discount) between items taxed at the general rate and items at 0%. Kept alongside `tax` so a
  // real Kushki integration can send them as-is instead of re-deriving them from order items.
  taxableSubtotal         Decimal         @default(0) @db.Decimal(12, 2)
  zeroTaxSubtotal         Decimal         @default(0) @db.Decimal(12, 2)
  tax                     Decimal         @default(0) @db.Decimal(12, 2)
  total                   Decimal         @db.Decimal(12, 2)
  currency                String          @default("USD")
  // Snapshot of the selected Address at order time (§12) — never re-reads the live Address, so
  // a later address edit never rewrites order history.
  deliveryAddressSnapshot Json?
  notes                   String?
  cancelReason            String?
  cancelledAt             DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  // Set only once this order's GMV has been swept into a business Payout
  // (PayoutsService.markBusinessesPaid) — null means "still outstanding, counted in the
  // business's pending payout total". Never cleared back to null once set, so an order's revenue
  // can be paid out to the business exactly once (see Payout model comment). Independent of
  // `status`/Payment.status, which track the customer's own purchase, not what BINGO+ owes back.
  payoutId String?

  user     User        @relation(fields: [userId], references: [id])
  business Business    @relation(fields: [businessId], references: [id])
  // SetNull, never Restrict: the live Address can be deleted freely — deliveryAddressSnapshot
  // above is what order history actually relies on, this FK is only a convenience link.
  address  Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payment  Payment?
  refunds  Refund[]
  delivery Delivery?
  disputes Dispute[]
  reviews  Review[]
  payout   Payout?     @relation(fields: [payoutId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([payoutId])
}

model OrderItem {
  id           String             @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  nameSnapshot String
  // SKU at time of purchase (§25) — Product.sku is optional/mutable, so this is the only
  // reliable record of what was actually sold once the live Product changes.
  skuSnapshot  String?
  quantity     Int
  unitPrice    Decimal            @db.Decimal(12, 2)
  subtotal     Decimal            @db.Decimal(12, 2)
  // Snapshot of Product.taxCategory at purchase time (same rationale as nameSnapshot/skuSnapshot)
  // plus the actual tax this line charged (subtotal × the rate for its category).
  taxCategory  ProductTaxCategory @default(STANDARD)
  taxAmount    Decimal            @default(0) @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

// ───────────────────────────── Payments (Phase 3) ─────────────────────────────

enum PaymentMethodType {
  CARD
  WALLET
  CASH
}

model PaymentMethod {
  id              String            @id @default(cuid())
  userId          String
  provider        String
  type            PaymentMethodType
  brand           String?
  last4           String?
  expirationMonth Int?
  expirationYear  Int?
  // Opaque provider reference (e.g. a Stripe PaymentMethod id) — never a raw card number/CVV/PIN.
  providerToken   String
  isDefault       Boolean           @default(false)
  createdAt       DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

// FASE 9 §1 / memberships-card-payment — exactly one of orderId/bookingId/membershipPaymentId is
// set, never more than one, never none. All three stay optional at the Prisma level (a single FK
// can't conditionally point at three tables) with a raw-SQL CHECK constraint added by the
// migration as the real DB-level guard — see migration.sql for `payment_exactly_one_target`.
// membershipPaymentId reuses this exact same real-payment machinery for a business's membership
// card charge (see MembershipsService.createMembershipCardPayment) — CASH-equivalent manual
// deposit/transfer for a membership never creates a Payment row at all, exactly like a Booking's
// CASH_PAYMENT_PROVIDER row is the one case that's written directly instead.
model Payment {
  id                  String        @id @default(cuid())
  orderId             String?       @unique
  bookingId           String?       @unique
  membershipPaymentId String?       @unique
  provider            String
  providerPaymentId   String?
  // Client-supplied idempotency key (§21) — a retried "create payment" request with the same
  // key returns the existing Payment instead of creating a second one.
  idempotencyKey      String?       @unique
  amount              Decimal       @db.Decimal(12, 2)
  currency            String        @default("USD")
  status              PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order             Order?             @relation(fields: [orderId], references: [id])
  booking           Booking?           @relation(fields: [bookingId], references: [id])
  membershipPayment MembershipPayment? @relation(fields: [membershipPaymentId], references: [id])
  transactions      Transaction[]
  refunds           Refund[]
}

enum TransactionType {
  CHARGE
  REFUND
}

model Transaction {
  id          String          @id @default(cuid())
  paymentId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  status      String
  providerRef String?
  rawResponse Json?
  createdAt   DateTime        @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

// A Refund is a customer-facing request/record (§36) — distinct from Transaction, which is the
// provider-level ledger entry a completed Refund produces.
model Refund {
  id          String       @id @default(cuid())
  paymentId   String
  orderId     String
  amount      Decimal      @db.Decimal(12, 2)
  reason      String?
  status      RefundStatus @default(PENDING)
  requestedBy String?
  providerRef String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@index([paymentId])
  @@index([orderId])
}

// Idempotency + audit trail for provider webhooks (§22) — a provider that redelivers the same
// event (at-least-once delivery is the norm) must never re-apply it twice.
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  processed       Boolean   @default(false)
  processedAt     DateTime?
  payloadHash     String
  createdAt       DateTime  @default(now())

  @@unique([provider, externalEventId])
}

// Single-row, admin-editable fee configuration (§9/37) — never hardcoded. Append-only history
// like MarketplaceRankingConfig: the latest row wins, so a fee change is auditable over time.
// Customer-facing checkout charges only — the business's own commission never lives here (see
// Commission/BusinessContract, set per-business at approval time) and delivery is priced by
// DeliveryFareConfig below, not a flat fee.
model PricingConfiguration {
  id                String   @id @default(cuid())
  serviceFeePercent Decimal  @default(0) @db.Decimal(5, 4)
  serviceFeeFixed   Decimal  @default(0) @db.Decimal(12, 2)
  defaultTaxPercent Decimal  @default(0) @db.Decimal(5, 4)
  updatedBy         String?
  createdAt         DateTime @default(now())
}

// BINGO+'s own legal identity — same append-only, latest-row-wins shape as PricingConfiguration.
// Feeds the "[RAZÓN SOCIAL BINGO+]"/"[RUC BINGO+]"/"[DIRECCIÓN BINGO+]"/"[REPRESENTANTE LEGAL
// BINGO+]" placeholders in the real business affiliation contract (ContractsService), replacing
// what used to be two hardcoded env vars (BINGOPLUS_LEGAL_REPRESENTATIVE_NAME/BINGOPLUS_LEGAL_RUC)
// with admin-editable, auditable data. A contract freezes these onto BusinessContract.bingoPlus*
// at generation time, exactly like every other contract variable — editing this here never rewrites
// a contract already generated or signed.
model PlatformLegalInfo {
  id                      String   @id @default(cuid())
  legalName               String
  taxId                   String
  addressLine             String
  latitude                Float?
  longitude               Float?
  legalRepresentativeName String
  // Uploaded once (a scanned/exported signature or stamp image), not drawn live like a business's
  // own canvas signature — BINGO+'s side of a contract is the same image on every contract, so it
  // belongs on this platform-wide config, not something captured per-signature. See
  // ContractsService.sign(), which fetches this URL's bytes into the PDF the same way the
  // business's own drawn signature is embedded.
  signatureImageUrl       String?
  // [CORREO DE PRIVACIDAD BINGO+] in the Política de Privacidad y Tratamiento de Datos Personales
  // — the address data-rights requests are directed to (see "11. DERECHOS DEL TITULAR"/"17.
  // CONTACTO" in that document). Deliberately separate from any general support/contact email.
  privacyEmail            String?
  updatedBy               String?
  createdAt               DateTime @default(now())
}

enum ContractTemplateType {
  BUSINESS
  RIDER
}

// Admin-editable contract template text (append-only, latest wins — same shape as
// PricingConfiguration). ContractsService/RiderContractsService read the latest row of the
// matching type at contract-GENERATION time and substitute its {{...}} placeholder tokens with
// that business/rider's actual live figures; the result is frozen onto the contract row itself
// (BusinessContract.contractText/RiderContract.contractText), exactly like today — editing the
// template here never changes a contract someone already signed.
model ContractTemplate {
  id        String               @id @default(cuid())
  type      ContractTemplateType
  content   String
  updatedBy String?
  createdAt DateTime             @default(now())

  @@index([type, createdAt])
}

// Admin-editable delivery fare formula (append-only, latest wins — same shape as
// PricingConfiguration/RiderDispatchConfig): delivery is an agreement between BINGO+ and the
// Rider, never something a business sets (see Business — it has no deliveryFeeUsd field). The
// fare floor is whichever minimum applies for the time of day, then the greater of that floor or
// the distance/time-based fare, times the live demand surge multiplier. From that same fare,
// BINGO+ keeps its cut and withholds the rider's tax — see RiderEarning.commissionAmount/
// taxWithheldAmount, computed at delivery completion using whatever this config's latest row says.
model DeliveryFareConfig {
  id                         String   @id @default(cuid())
  minFareDay                 Decimal  @default(0) @db.Decimal(12, 2)
  minFareNight               Decimal  @default(0) @db.Decimal(12, 2)
  // Local hour (business timezone, 0-23) the night rate starts — e.g. 20 = 8pm.
  nightStartHour             Int      @default(20)
  // Local hour (business timezone, 0-23) the night rate ends — e.g. 6 = 6am.
  nightEndHour               Int      @default(6)
  perKmRate                  Decimal  @default(0) @db.Decimal(12, 2)
  perMinuteRate              Decimal  @default(0) @db.Decimal(12, 2)
  // Ratio of deliveries awaiting a rider to available riders at/above which surge applies.
  surgeThreshold             Decimal  @default(2) @db.Decimal(6, 2)
  // Multiplier applied to the whole fare once surgeThreshold is met — 1 = no surge.
  surgeMultiplier            Decimal  @default(1) @db.Decimal(6, 2)
  bingoCommissionPercent     Decimal  @default(0) @db.Decimal(5, 4)
  riderTaxWithholdingPercent Decimal  @default(0) @db.Decimal(5, 4)
  updatedBy                  String?
  createdAt                  DateTime @default(now())
}

// ───────────────────────────── Riders & delivery (Phase 4) ─────────────────────────────

// §7: deliberately separate from RiderAvailabilityStatus — a Rider can be ACTIVE+OFFLINE,
// ACTIVE+AVAILABLE or ACTIVE+BUSY, none of which are expressible with a single combined enum
// (the Phase 2 placeholder `RiderStatus` mixed both and is replaced by this pair).
enum RiderAccountStatus {
  PENDING_APPROVAL
  // Admin approved the application and a RiderContract was generated — same gate as Business's
  // APPROVED: not ACTIVE (can't go online/receive deliveries) until the rider actually signs it.
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
  INACTIVE
}

enum RiderAvailabilityStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

// Unlike Business (always RUC or a local cédula, never a passport — a registered company/person
// filing local taxes), a Rider applicant can be a foreign national without an Ecuadorian cédula,
// so this is its own enum rather than reusing BusinessIdType. PASAPORTE is treated exactly like
// CEDULA everywhere legalName/"razón social" logic branches on RUC vs. not-RUC (RiderProfileService
// .applyAsRider, RiderContractsService) — both are a natural person acting on their own behalf.
enum RiderIdType {
  RUC
  CEDULA
  PASAPORTE
}

model Rider {
  id                    String                                 @id @default(cuid())
  userId                String                                 @unique
  accountStatus         RiderAccountStatus                     @default(PENDING_APPROVAL)
  availabilityStatus    RiderAvailabilityStatus                @default(OFFLINE)
  // Simple zone signal for eligibility filtering (§18) — not a geofence/polygon system, that's a
  // later refinement; proximity itself is computed from currentLocation, not from this string.
  city                  String?
  // Application basics — collected once, at apply time (see RiderProfileService.applyAsRider).
  // legalName is the "razón social" and is only ever collected (or shown) for RUC; a CEDULA/
  // PASAPORTE rider's name is just their own User.firstName/lastName, read-only.
  idType                RiderIdType?
  legalName             String?
  birthDate             DateTime?
  nationalIdNumber      String?
  address               String?
  // Set only once both checkboxes are actually ticked in the same submission — never defaulted,
  // never backfilled silently, so their presence is real proof of consent, not just a boolean flag.
  termsAcceptedAt       DateTime?
  dataConsentAcceptedAt DateTime?
  currentLatitude       Float?
  currentLongitude      Float?
  currentLocation       Unsupported("geography(Point, 4326)")?
  lastLocationAt        DateTime?
  ratingAvg             Float                                  @default(0)
  reviewCount           Int                                    @default(0)
  deliveriesCompleted   Int                                    @default(0)
  createdAt             DateTime                               @default(now())
  updatedAt             DateTime                               @updatedAt

  user                        User                         @relation(fields: [userId], references: [id])
  vehicles                    Vehicle[]
  documents                   RiderDocument[]
  payoutMethod                RiderPayoutMethod?
  deliveries                  Delivery[]
  earnings                    RiderEarning[]
  payouts                     Payout[]
  locations                   RiderLocation[]
  assignmentHistory           DeliveryAssignmentHistory[]
  contracts                   RiderContract[]
  commissionOverrides         RiderCommissionOverride[]
  commissionCouponRedemptions CommissionCouponRedemption[]

  @@index([accountStatus])
  @@index([availabilityStatus])
}

// Created automatically the moment Admin approves a rider application (RidersService.approve) —
// mirrors BusinessContract exactly: nothing goes ACTIVE (able to receive deliveries) until this is
// signed. Snapshots the signer identity and the platform's current delivery-fare commission/tax
// terms at creation time, never re-read live once written — the same "frozen photo" reasoning as
// BusinessContract.commissionRatePercent, just sourced from DeliveryFareConfig instead of Commission.
model RiderContract {
  id                          String         @id @default(cuid())
  riderId                     String
  status                      ContractStatus @default(PENDING_SIGNATURE)
  idType                      RiderIdType
  // Razón social for RUC, or the rider's own User.firstName+lastName for CEDULA — always
  // populated, exactly like BusinessContract.legalName, since the PDF signer line needs it either way.
  legalName                   String
  taxId                       String
  // Frozen at contract-generation time from DeliveryFareConfig — see the model-level comment.
  bingoCommissionPercent      Decimal        @db.Decimal(5, 2)
  riderTaxWithholdingPercent  Decimal        @db.Decimal(5, 2)
  // Every other placeholder the real contract text (see ContractTemplateService's RIDER default)
  // substitutes at generation time — same "frozen photo" reasoning as the fields above, mirroring
  // BusinessContract's own bingoPlus*/bank* snapshot fields exactly.
  riderPhone                  String?
  riderEmail                  String?
  riderAddress                String?
  // "No aplica" for a bicycle (per the variable dictionary), the real value otherwise — stored as
  // the already-resolved display string, not the raw VehicleType, so the frozen text never needs
  // to re-derive it.
  vehicleType                 String?
  vehicleColor                String?
  vehicleBrand                String?
  vehicleModel                String?
  vehicleYear                 String?
  vehiclePlate                String?
  licenseNumber               String?
  licenseExpiration           String?
  bankName                    String?
  bankAccountType             String?
  bankAccountNumber           String?
  bankAccountHolderName       String?
  bingoPlusLegalName          String?
  bingoPlusTaxId              String?
  bingoPlusAddress            String?
  bingoPlusRepresentativeName String?
  bingoPlusSignatureImageUrl  String?
  contractText                String
  signatureDataUrl            String?
  signedAt                    DateTime?
  signedIp                    String?
  pdfUrl                      String?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum VehicleType {
  WALK
  BIKE
  MOTORCYCLE
  CAR
  OTHER
}

model Vehicle {
  id      String        @id @default(cuid())
  riderId String
  type    VehicleType
  status  VehicleStatus @default(ACTIVE)
  plate   String?
  brand   String?
  model   String?
  color   String?
  year    Int?

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
}

enum RiderDocumentType {
  ID
  SELFIE
  LICENSE
  INSURANCE
  VEHICLE_REGISTRATION
  CONTRACT
}

// Own status enum rather than reusing the shared `DocumentStatus` (BusinessDocument) — riders
// need EXPIRED, which doesn't apply to business documents.
enum RiderDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// Only meaningful for type=ID (a physical ID card has two faces) — null for LICENSE/INSURANCE/
// VEHICLE_REGISTRATION, which are each a single document. Postgres treats every NULL as distinct
// in a unique index, so those types can still have multiple historical rows; ID FRONT/BACK
// cannot duplicate because the constraint below pins exactly one live row per (riderId, ID, side).
enum RiderDocumentSide {
  FRONT
  BACK
}

model RiderDocument {
  id             String              @id @default(cuid())
  riderId        String
  type           RiderDocumentType
  side           RiderDocumentSide?
  documentNumber String?
  fileUrl        String
  status         RiderDocumentStatus @default(PENDING)
  expirationDate DateTime?
  // "verifiedBy"/"verifiedAt" in spec terms — named reviewedBy/reviewedAt to match the identical
  // pattern already used on BusinessDocument.
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([riderId, type, side])
  @@index([riderId])
}

enum RiderPayoutMethodType {
  BANK_ACCOUNT
  MOBILE_WALLET
}

enum RiderBankAccountType {
  SAVINGS
  CHECKING
}

// One payout destination per rider (kept intentionally simple — a ledger of where completed-
// delivery earnings get paid out to, not a second PaymentMethod/PCI-scoped card store; nothing
// here is card data). Storing these fields in plaintext is a known MVP tradeoff — see
// docs/status for the corresponding technical-debt note about encrypting at rest before this
// goes to production with real payouts.
model RiderPayoutMethod {
  id                   String                @id @default(cuid())
  riderId              String                @unique
  method               RiderPayoutMethodType
  bankName             String?
  accountType          RiderBankAccountType?
  accountNumber        String?
  walletProvider       String?
  walletNumber         String?
  accountHolderName    String
  holderDocumentNumber String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
}

// §15/16: the logistics lifecycle — entirely separate from OrderStatus. See the OrderStatus
// comment above for how the two are synchronized.
enum DeliveryStatus {
  PENDING
  SEARCHING_RIDER
  RIDER_ASSIGNED
  RIDER_ACCEPTED
  GOING_TO_PICKUP
  ARRIVED_AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_CUSTOMER
  DELIVERED
  CANCELLED
  FAILED
}

enum DeliveryAssignmentSource {
  AUTO
  ADMIN
  MANUAL
}

model Delivery {
  id      String         @id @default(cuid())
  orderId String         @unique
  riderId String?
  status  DeliveryStatus @default(PENDING)

  // §12: snapshots, never reconstructed from the live Business/Address — a Delivery must stay
  // historically accurate even if the business moves or the customer edits/deletes the address.
  pickupAddressSnapshot   Json
  deliveryAddressSnapshot Json

  estimatedDistanceKm      Float?
  estimatedDurationMinutes Int?
  actualDistanceKm         Float?
  actualDurationMinutes    Int?
  route                    Json?

  // §47: copied from Order.deliveryFee at creation time — Phase 4 never recomputes/changes the
  // order total; dynamic pricing is an explicit future phase.
  deliveryFee Decimal @db.Decimal(12, 2)

  assignmentSource DeliveryAssignmentSource?
  assignedAt       DateTime?
  acceptedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  order             Order                       @relation(fields: [orderId], references: [id])
  rider             Rider?                      @relation(fields: [riderId], references: [id])
  assignmentHistory DeliveryAssignmentHistory[]
  locations         RiderLocation[]
  proof             DeliveryProof?
  incidents         DeliveryIncident[]
  earnings          RiderEarning[]
  chatMessages      DeliveryChatMessage[]

  @@index([riderId])
  @@index([status])
  @@index([createdAt])
}

enum DeliveryAssignmentAction {
  ASSIGNED
  ACCEPTED
  REJECTED
  TIMED_OUT
  REASSIGNED
  CANCELLED
}

// §23: full audit trail of who got offered a delivery and what happened — how reassignment after
// a rejection/timeout stays explainable instead of just overwriting Delivery.riderId silently.
model DeliveryAssignmentHistory {
  id         String                   @id @default(cuid())
  deliveryId String
  riderId    String?
  action     DeliveryAssignmentAction
  reason     String?
  source     DeliveryAssignmentSource
  createdAt  DateTime                 @default(now())

  // Dispatch V2: populated by DispatchService.assign() at ASSIGNED-row-write time from whatever
  // EtaRankingService already computed for the winning candidate — the data analytics (acceptance
  // rate, avg ETA, attempts per delivery) needs. Nullable/optional because older rows (and any
  // non-ASSIGNED action) never had this computed. attemptNumber = count of prior ASSIGNED rows for
  // this delivery + 1; "response time" stays a derived query, not a stored column.
  estimatedDistanceKm Decimal? @db.Decimal(8, 2)
  estimatedETAMinutes Int?
  attemptNumber       Int?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider    Rider?   @relation(fields: [riderId], references: [id])

  @@index([deliveryId])
  @@index([riderId])
  @@index([createdAt])
}

// §35/36: only ever written while `deliveryId` points at an active Delivery — there is no
// route to create a row for a rider who isn't currently on a delivery, which is the retention
// policy: no active delivery, no stored location history. Rider.currentLatitude/Longitude above
// is the single "where is this rider right now" value used outside of an active delivery.
model RiderLocation {
  id         String   @id @default(cuid())
  riderId    String
  deliveryId String
  latitude   Float
  longitude  Float
  heading    Float?
  speed      Float?
  accuracy   Float?
  createdAt  DateTime @default(now())

  rider    Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([deliveryId])
  @@index([createdAt])
}

enum DeliveryProofType {
  OTP
  PHOTO
  SIGNATURE
  CUSTOMER_CONFIRMATION
}

// §30/31: MVP implements OTP — the other types are modeled so photo/signature proof can be added
// later without a schema change.
model DeliveryProof {
  id         String            @id @default(cuid())
  deliveryId String            @unique
  type       DeliveryProofType
  // Deliberately NOT hashed, unlike passwords/refresh tokens elsewhere: the customer needs to
  // read this code from Tracking throughout the delivery (§31), not just once at generation, so
  // it must stay recoverable. Mitigations are a short expiresAt, rate-limited verify attempts,
  // and ownership-scoped read access (only the order's own customer can fetch it).
  code       String?
  photoUrl   String?
  attempts   Int               @default(0)
  expiresAt  DateTime?
  verifiedAt DateTime?
  createdAt  DateTime          @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

enum DeliveryIncidentType {
  RIDER_NO_SHOW
  CUSTOMER_UNAVAILABLE
  BUSINESS_DELAY
  VEHICLE_ISSUE
  WRONG_ADDRESS
  DAMAGED_ORDER
  OTHER
}

enum DeliveryIncidentStatus {
  OPEN
  RESOLVED
}

model DeliveryIncident {
  id          String                 @id @default(cuid())
  deliveryId  String
  reportedBy  String
  type        DeliveryIncidentType
  description String?
  status      DeliveryIncidentStatus @default(OPEN)
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([status])
}

enum DeliveryChatSenderType {
  CUSTOMER
  RIDER
}

// Rider<->Customer chat for an active delivery (the app owner's "chat bidireccional" ask) —
// deliberately NOT modeled like SupportChatMessage: no imageUrl (text-only per spec, kept simple),
// no separate open/closed status field, because "closed" is never anything but "this Delivery
// reached a terminal state" (DELIVERED/CANCELLED/FAILED — DeliveryStateMachine.isTerminal), and
// inventing a second state machine to track the same fact Delivery.status already expresses would
// just be two sources of truth that could disagree. DeliveryChatService is the single place that
// enforces "no messages once terminal, and only once a rider is actually assigned" by reading
// Delivery.status/riderId live on every send — never a cached/duplicated flag here.
model DeliveryChatMessage {
  id           String                 @id @default(cuid())
  deliveryId   String
  senderType   DeliveryChatSenderType
  senderUserId String
  text         String
  createdAt    DateTime               @default(now())
  readAt       DateTime?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  sender   User     @relation("DeliveryChatMessageSender", fields: [senderUserId], references: [id])

  @@index([deliveryId])
  @@index([deliveryId, createdAt])
}

enum RiderEarningType {
  DELIVERY_FEE
  TIP
  BONUS
}

enum RiderEarningStatus {
  PENDING
  CONFIRMED
  PAID
}

model RiderEarning {
  id                String             @id @default(cuid())
  riderId           String
  deliveryId        String?
  grossAmount       Decimal            @db.Decimal(12, 2)
  // The two deductions DeliveryFareConfig defines, broken out explicitly (not folded into
  // `adjustments`, which is for other manual adjustments like tips/bonuses/penalties) so the
  // rider can see exactly what BINGO+ kept vs. what was withheld for tax.
  commissionAmount  Decimal            @default(0) @db.Decimal(12, 2)
  taxWithheldAmount Decimal            @default(0) @db.Decimal(12, 2)
  adjustments       Decimal            @default(0) @db.Decimal(12, 2)
  netAmount         Decimal            @db.Decimal(12, 2)
  currency          String             @default("USD")
  type              RiderEarningType
  status            RiderEarningStatus @default(PENDING)
  createdAt         DateTime           @default(now())

  // Set only once this earning has been swept into a rider Payout (PayoutsService.markRidersPaid)
  // — null means "still outstanding, counted in the rider's pending total". Never cleared back to
  // null once set, so an earning can be paid out exactly once (see Payout model comment).
  payoutId String?

  rider    Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  delivery Delivery? @relation(fields: [deliveryId], references: [id])
  payout   Payout?   @relation(fields: [payoutId], references: [id])

  @@index([riderId])
  @@index([deliveryId])
  @@index([status])
  @@index([payoutId])
}

// §19: dispatch weighting/timeout, admin-configurable — append-only history like
// PricingConfiguration, so a weighting change stays auditable and dispatch never hardcodes them.
model RiderDispatchConfig {
  id                       String  @id @default(cuid())
  distanceWeight           Decimal @default(0.5) @db.Decimal(5, 4)
  ratingWeight             Decimal @default(0.3) @db.Decimal(5, 4)
  availabilityWeight       Decimal @default(0.2) @db.Decimal(5, 4)
  maxSearchRadiusKm        Decimal @default(10) @db.Decimal(6, 2)
  assignmentTimeoutSeconds Int     @default(60)

  // Dispatch V2 (offer timeout + ETA ranking + progressive radius expansion) — all admin-tunable,
  // never hardcoded, same append-only-config convention as the fields above.
  etaWeight                     Decimal @default(0.6) @db.Decimal(5, 4)
  maxCandidatesForEta           Int     @default(8)
  locationStaleThresholdSeconds Int     @default(120)
  // Postgres array, same pattern as Service.operatingDays — each step tried in order by
  // DispatchOrchestratorService until one yields a candidate.
  radiusExpansionKm             Int[]   @default([2, 4, 6, 8])
  retryBackoffSeconds           Int     @default(15)
  // A ceiling on total ASSIGNED attempts across a delivery's whole retry lifetime — a delivery
  // never auto-FAILS from this alone, it just stops auto-retrying and needs manual admin attention.
  maxDispatchAttempts           Int     @default(20)

  updatedBy String?
  createdAt DateTime @default(now())
}

// ───────────────────────────── Services & bookings (Phase 7) ─────────────────────────────

enum ServiceType {
  VETERINARY
  DAYCARE
  BOARDING
  GROOMING
  DOG_WALKING
  // Added alongside the "Adiestradores"/"Otros Pet services" Directory categories, which had no
  // fitting ServiceType before this — a trainer or another kind of pet-service business couldn't
  // create a bookable service that actually described what they do.
  TRAINING
  OTHER
}

// Where the service is actually rendered — freely choosable on every service, no capability
// prerequisite. BOTH lets a customer pick per-booking. Drives whether "Cómo llegar" makes sense
// to show on the customer-facing service/business page (a business whose active services are all
// AT_CUSTOMER_HOME has no premises worth visiting) — see ServicesService.resolveLocationType,
// which auto-enables HOME_SERVICE the first time a business uses AT_CUSTOMER_HOME/BOTH.
enum ServiceLocationType {
  AT_BUSINESS
  AT_CUSTOMER_HOME
  BOTH
}

model Service {
  id              String              @id @default(cuid())
  businessId      String
  type            ServiceType
  name            String
  description     String?
  price           Decimal             @db.Decimal(12, 2)
  locationType    ServiceLocationType @default(AT_BUSINESS)
  // Meaningless for DAYCARE/BOARDING (those are booked by date range, not a time slot) — the DTO
  // still requires it for schema simplicity, the frontend just sends a nominal value for those
  // two types and never shows the field. See BookingsService's DAY_UNIT_TYPES branch.
  durationMinutes Int
  // Which weekdays ('sun'..'sat', same keys as Business.openingHours) DAYCARE/BOARDING actually
  // operates — e.g. a daycare open weekdays only. Empty/unused for every other ServiceType; a
  // customer's check-in/check-out range only counts nights/days that fall on one of these.
  operatingDays   String[]            @default([])
  // Max simultaneous bookings for the same time slot — null defaults to 1 (single-provider
  // service, e.g. a vet consultation) in BookingsService, never silently unlimited.
  capacity        Int?
  imageUrl        String?
  // Free-text ("trae la cartilla de vacunas", "mascota debe estar bañada", etc.) — a single
  // field rather than a new table, same reasoning as Business.description.
  requirements    String?
  minAgeMonths    Int?
  maxAgeMonths    Int?
  // Phase 8: derived exclusively from Review aggregation (ReviewsService.recomputeAggregate).
  ratingAvg       Float               @default(0)
  reviewCount     Int                 @default(0)
  active          Boolean             @default(true)
  // Soft delete, same pattern as Product/Business — a hard delete would violate the FK from any
  // past Booking still pointing at this service (bookings must keep reading a real service row
  // forever, even a "deleted" one). Excluded from every business/public/admin list and get.
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  species            ServiceSpecies[]
  availabilityBlocks AvailabilityBlock[]

  @@index([businessId])
}

// Mirrors ProductSpecies exactly (same join-table shape) — kept as its own table rather than
// reusing ProductSpecies because a Service is a different owning entity, not because the concept
// is different.
model ServiceSpecies {
  serviceId String
  speciesId String

  service Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  species PetSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([serviceId, speciesId])
  @@index([speciesId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Distinguishes a real customer booking made through the app from a business-entered manual block
// (an off-platform phone/walk-in appointment the business logs so it isn't double-booked) — see
// BookingsService.createManualBlock. Both sit in the exact same table and compete for the exact
// same Service.capacity via the exact same overlap-counting query, so a MANUAL row genuinely blocks
// an APP booking and vice versa — never two parallel/inconsistent capacity tallies.
enum BookingSource {
  APP
  MANUAL
}

model Booking {
  id             String        @id @default(cuid())
  // Null only for a MANUAL block — there's no customer behind an off-platform appointment the
  // business logs itself. Every APP booking always has one (enforced in BookingsService.create).
  userId         String?
  petId          String?
  businessId     String
  serviceId      String
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus @default(PENDING)
  source         BookingSource @default(APP)
  price          Decimal       @db.Decimal(12, 2)
  // Checkout breakdown (§ card/cash booking payment) — frozen at booking creation time from the
  // live PricingConfiguration, same snapshot discipline as `price`/`billableDays` below: a later
  // change to PricingConfiguration.defaultTaxPercent/serviceFeePercent/serviceFeeFixed must never
  // retroactively rewrite what a customer was already shown and agreed to pay. `tax` is simply
  // price × defaultTaxPercent (a Service has no ProductTaxCategory-style exemption concept, unlike
  // Product — every service is taxed at the flat default rate). `serviceFee` is the exact same
  // formula PriceCalculationService/MembershipsService.computeServiceFee use:
  // price × serviceFeePercent + serviceFeeFixed. `total` (= price + tax + serviceFee) is what's
  // actually charged (createBookingPayment/chooseCashPayment) — never `price` alone. Rows created
  // before this feature existed were backfilled with tax=0/serviceFee=0/total=price by this
  // migration, so an already-CONFIRMED-awaiting-payment booking keeps charging exactly what it
  // always would have.
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  serviceFee     Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  // Set only once this booking's price+tax has been swept into a business Payout
  // (PayoutsService.markBusinessBookingItemsPaid/markBusinessBookingsPaid) — same "swept exactly
  // once" mechanism as Order.payoutId/RiderEarning.payoutId (see the Payout model comment). Only a
  // CARD-paid (never CASH), PAID booking is ever eligible to owe the business anything in the
  // first place — see PayoutsService's CARD_PAID_BOOKING_WHERE.
  payoutId       String?
  // Set only for a DAYCARE/BOARDING booking — how many of Service.operatingDays fell inside
  // [startTime, endTime) at creation time, frozen here since a later change to the service's
  // operatingDays or price must never retroactively rewrite what was already booked and priced
  // (price above is exactly service.price × this number at booking time). Null for every
  // time-slot-based booking (startTime/endTime already span the one slot for those).
  billableDays   Int?
  // Resolved at creation from Service.locationType: forced false for AT_BUSINESS, forced true for
  // AT_CUSTOMER_HOME, and the customer's own choice for BOTH — see BookingsService.create's
  // resolveAtCustomerHome. Drives whether the business needs the customer's address for this visit.
  atCustomerHome Boolean       @default(false)
  notes          String?
  // Client-supplied idempotency key (same pattern as Payment.idempotencyKey) — a retried
  // "create booking" request (double-tap) with the same key returns the original booking instead
  // of creating a second one.
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  pet      Pet?      @relation(fields: [petId], references: [id])
  business Business  @relation(fields: [businessId], references: [id])
  service  Service   @relation(fields: [serviceId], references: [id])
  reviews  Review[]
  disputes Dispute[]
  payment  Payment?
  payout   Payout?   @relation(fields: [payoutId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([serviceId, startTime, endTime])
  @@index([payoutId])
}

// FASE 9 §2 — a Weekly Business Schedule (Business.openingHours) alone can't represent
// exceptions (vacations, holidays, maintenance). A block can target the whole business
// (serviceId null) or just one service; availability calculation must always subtract these
// before returning a slot/range as open.
enum AvailabilityBlockStatus {
  ACTIVE
  CANCELLED
}

model AvailabilityBlock {
  id            String                  @id @default(cuid())
  businessId    String
  serviceId     String?
  startDateTime DateTime
  endDateTime   DateTime
  reason        String?
  status        AvailabilityBlockStatus @default(ACTIVE)
  createdBy     String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([serviceId])
  @@index([startDateTime, endDateTime])
}

// ───────────────────────────── Pet-friendly community directory ─────────────────────────────
// Deliberately NOT a Business/membership/capability concept (unlike Grooming/Veterinarios/etc.)
// — any logged-in user can submit a place (a restaurant, park, café...) that welcomes pets but
// isn't a registered BINGO+ business. Submissions start PENDING and only become visible to
// everyone once an admin approves them (see PetFriendlyPlacesService / AdminPetFriendlyPlacesController).

enum PetFriendlyPlaceCategory {
  RESTAURANT
  OUTDOOR_SPACE
  OTHER
}

enum PetFriendlyPlaceStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model PetFriendlyPlace {
  id              String                                 @id @default(cuid())
  name            String
  category        PetFriendlyPlaceCategory
  description     String?
  address         String
  latitude        Float
  longitude       Float
  location        Unsupported("geography(Point, 4326)")?
  photoUrl        String?
  status          PetFriendlyPlaceStatus                 @default(PENDING)
  ratingAvg       Float                                  @default(0)
  reviewCount     Int                                    @default(0)
  submittedById   String
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                               @default(now())
  updatedAt       DateTime                               @updatedAt

  submittedBy User  @relation("PetFriendlyPlaceSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User? @relation("PetFriendlyPlaceReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([category])
}

// ───────────────────────────── Reputation & growth (Phase 8) ─────────────────────────────

enum ReviewTargetType {
  BUSINESS
  RIDER
  SERVICE
  PRODUCT
  // A business/rider rating a customer after an order — the source of User.ratingAvg once the
  // Phase 8 reviews module builds the endpoint to create these.
  CUSTOMER
  // No order/booking context (any approved place, rated by any user) — the uniqueness guard for
  // this target type is a partial index added by migration SQL, not the two existing
  // orderId/bookingId-based @@unique constraints below (both would always be null here, and
  // Postgres treats every NULL as distinct, so neither blocks a duplicate on its own).
  PET_FRIENDLY_PLACE
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

model Review {
  id                String           @id @default(cuid())
  authorId          String
  targetType        ReviewTargetType
  targetId          String
  orderId           String?
  bookingId         String?
  rating            Int
  comment           String?
  status            ReviewStatus     @default(PUBLISHED)
  // §3.5: the Business being reviewed can reply once, publicly — never edit/delete the review
  // itself, only add its own response alongside it.
  businessReply     String?
  businessRepliedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  author  User           @relation(fields: [authorId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])
  booking Booking?       @relation(fields: [bookingId], references: [id])
  reports ReviewReport[]

  // One rating per author/target/order — the DB-level guard against a double-tap or two
  // concurrent submits both creating a duplicate review (same discipline as the guarded
  // transitions elsewhere: let the constraint be the source of truth, not a read-then-write check).
  // A second, separate constraint covers booking-based (Service) reviews: orderId is always NULL
  // there, and Postgres treats each NULL as distinct, so the constraint above alone would never
  // actually block a duplicate submission for the same booking — this one closes that gap without
  // touching the order-based guard (each constraint is a no-op on rows the other one governs,
  // since exactly one of orderId/bookingId is non-null per row).
  @@unique([authorId, targetType, targetId, orderId])
  @@unique([authorId, targetType, targetId, bookingId])
  @@index([targetType, targetId])
}

enum ReviewReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model ReviewReport {
  id         String             @id @default(cuid())
  reviewId   String
  reportedBy String
  reason     String
  status     ReviewReportStatus @default(OPEN)
  resolution String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime           @default(now())

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reportedBy], references: [id])

  @@index([reviewId])
  @@index([status])
}

enum FavoriteTargetType {
  BUSINESS
  PRODUCT
  SERVICE
  PET_FRIENDLY_PLACE
}

// Polymorphic by design (targetType + targetId): a favorite can point at a Business, Product,
// Service or PetFriendlyPlace. Prisma has no native polymorphic relation, so the target is
// resolved in the service layer by targetType rather than as a declared FK — this mirrors how
// Review.targetType/targetId already works for the same reason.
model Favorite {
  id         String             @id @default(cuid())
  userId     String
  targetType FavoriteTargetType
  targetId   String
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
}

// ───────────────────────────── Business coupons (presential redemption) ─────────────────────────
//
// Replaces the earlier placeholder Promotion/Coupon models (schema-only, never wired to an API —
// no data or endpoint depended on them, so replacing rather than extending them is safe). This is
// a deliberately different model: a BusinessCoupon is never auto-applied at Marketplace checkout
// (RULE 14/15) — the customer shows a QR in person, the business scans it, and the discount is
// settled directly between customer and business; BINGO+ never processes that payment.

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BusinessCouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model BusinessCoupon {
  id                 String               @id @default(cuid())
  businessId         String
  code               String
  title              String
  description        String?
  discountType       CouponDiscountType
  discountValue      Decimal              @db.Decimal(12, 2)
  minimumPurchase    Decimal?             @db.Decimal(12, 2)
  maximumDiscount    Decimal?             @db.Decimal(12, 2)
  startDate          DateTime
  expirationDate     DateTime
  usageLimit         Int?
  usagePerCustomer   Int?
  termsAndConditions String?
  status             BusinessCouponStatus @default(DRAFT)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([status])
  @@index([expirationDate])
}

// Redemption status lives here, per-customer, precisely because a single coupon is redeemed by
// many different customers — it is never a status on BusinessCoupon itself.
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  businessId     String
  customerId     String
  petId          String?
  redeemedAt     DateTime @default(now())
  discountAmount Decimal  @db.Decimal(12, 2)
  purchaseAmount Decimal? @db.Decimal(12, 2)
  currency       String   @default("USD")
  metadata       Json?

  coupon   BusinessCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  business Business       @relation(fields: [businessId], references: [id])
  customer User           @relation("CouponRedeemer", fields: [customerId], references: [id])
  pet      Pet?           @relation(fields: [petId], references: [id])

  @@index([couponId])
  @@index([customerId])
  @@index([businessId])
}

// ───────────────────────────── Promotions (Phase 8) ─────────────────────────────
//
// Deliberately separate from BusinessCoupon/AdminCoupon (RULE 3/4/14/15 — FASE 8 rules 2/3/4):
// a Promotion never requires a code and can auto-apply at Marketplace checkout, which
// BusinessCoupon/AdminCoupon are explicitly forbidden from doing. DiscountService.calculate() —
// previously a stub returning zero — is the one integration point where this plugs into pricing.

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

// Polymorphic by design (targetType + targetId), same pattern as Review/Favorite — a promotion
// can point at one or more Products, ProductCategories, Services or the whole Business.
enum PromotionTargetType {
  PRODUCT
  PRODUCT_CATEGORY
  SERVICE
  BUSINESS
}

model Promotion {
  id              String          @id @default(cuid())
  businessId      String
  name            String
  description     String?
  type            PromotionType
  // Percentage as 0-100 (not 0-1, to match how BusinessCoupon.discountValue is already entered)
  // for PERCENTAGE; a currency amount for FIXED_AMOUNT.
  value           Decimal         @db.Decimal(12, 2)
  minimumPurchase Decimal?        @db.Decimal(12, 2)
  maximumDiscount Decimal?        @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime
  status          PromotionStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  targets  PromotionTarget[]

  @@index([businessId])
  @@index([status])
  @@index([startDate, endDate])
}

model PromotionTarget {
  id          String              @id @default(cuid())
  promotionId String
  targetType  PromotionTargetType
  targetId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([targetType, targetId])
}

// ───────────────────────────── Admin coupons (membership billing) ───────────────────────────────
//
// Deliberately separate from BusinessCoupon (RULE 16/17): an AdminCoupon discounts what a
// *business* owes BINGO+ for its Directory membership — it never touches a customer-facing
// Marketplace order. Mixing the two would make Marketplace GMV and membership revenue
// impossible to report on independently.

enum AdminCouponType {
  PERCENTAGE_DISCOUNT
  FIXED_AMOUNT_DISCOUNT
  FREE_MONTHS
  FREE_TRIAL_EXTENSION
}

enum AdminCouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model AdminCoupon {
  id                 String            @id @default(cuid())
  code               String            @unique
  name               String
  description        String?
  discountType       AdminCouponType
  discountValue      Decimal?          @db.Decimal(12, 2)
  freeMonths         Int?
  startDate          DateTime
  expirationDate     DateTime
  usageLimit         Int?
  usagePerBusiness   Int?
  applicablePlans    String[]          @default([])
  status             AdminCouponStatus @default(DRAFT)
  termsAndConditions String?
  createdBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  redemptions AdminCouponRedemption[]

  @@index([status])
  @@index([expirationDate])
}

model AdminCouponRedemption {
  id           String   @id @default(cuid())
  couponId     String
  membershipId String
  redeemedAt   DateTime @default(now())
  // Immutable receipt of exactly what was granted (discount amount, free months, ...) — a later
  // change to the coupon definition must never retroactively change what was already applied.
  appliedValue Json
  metadata     Json?

  coupon     AdminCoupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  membership BusinessMembership @relation(fields: [membershipId], references: [id])

  @@index([couponId])
  @@index([membershipId])
}

// ───────────────────────────── Commission coupons (acquisition/retention) ───────────────────────
//
// Deliberately separate from AdminCoupon (which discounts membership billing) and from
// BusinessCoupon/Promotion (customer-facing Marketplace discounts) — a CommissionCoupon lowers
// what BINGO+ itself keeps from a business's sales or a rider's delivery fares, for a limited
// time, as an incentive (e.g. "10% instead of 20% for riders this quarter"). Redeeming one never
// mutates this row — it writes a normal, time-bound Commission row (business) or
// RiderCommissionOverride row (rider); see those models for how the reduced rate actually takes
// effect and automatically reverts once expired (no scheduled job involved).

enum CommissionCouponTargetType {
  BUSINESS
  RIDER
}

model CommissionCoupon {
  id                String                     @id @default(cuid())
  code              String                     @unique
  name              String
  description       String?
  targetType        CommissionCouponTargetType
  // The reduced rate itself — e.g. 0.10 for "BINGO+ keeps 10%" — same Decimal(5,4) shape as
  // Commission.rate / DeliveryFareConfig.bingoCommissionPercent, whichever this coupon targets.
  commissionPercent Decimal                    @db.Decimal(5, 4)
  startDate         DateTime
  // Also the moment the discount itself expires for anyone who already redeemed — not a
  // per-redeemer duration, a shared campaign window (see model-level comment).
  expirationDate    DateTime
  usageLimit        Int?
  status            AdminCouponStatus          @default(DRAFT)
  createdBy         String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  redemptions CommissionCouponRedemption[]

  @@index([status])
  @@index([expirationDate])
}

model CommissionCouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  // Exactly one of these is set, matching the coupon's targetType — enforced in
  // CommissionCouponsService, not at the schema level (Prisma has no CHECK-constraint DSL).
  businessId String?
  riderId    String?
  redeemedAt DateTime @default(now())

  coupon   CommissionCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  business Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rider    Rider?           @relation(fields: [riderId], references: [id], onDelete: Cascade)

  // NULL is distinct per-row in Postgres, so a rider redemption (businessId NULL) never collides
  // with another rider's here — this only actually blocks the SAME business/rider redeeming twice.
  @@unique([couponId, businessId])
  @@unique([couponId, riderId])
  @@index([businessId])
  @@index([riderId])
}

// ───────────────────────────── Business membership (Directory billing) ──────────────────────────
//
// A financial domain separate from Marketplace orders (RULE 17): Membership → Subscription →
// Invoice is how a business pays BINGO+ for Directory presence; it is never an Order.

enum BillingFrequency {
  MONTHLY
  YEARLY
}

enum MembershipPlanStatus {
  ACTIVE
  INACTIVE
}

model MembershipPlan {
  id                   String               @id @default(cuid())
  name                 String
  description          String?
  price                Decimal              @db.Decimal(12, 2)
  currency             String               @default("USD")
  billingFrequency     BillingFrequency
  // Configurable, never hardcoded (RULE 13-style requirement extended to membership terms).
  trialDays            Int                  @default(0)
  benefits             Json?
  applicableCategories String[]             @default([])
  // The plan a new BusinessMembership is created on at business-approval time when none is
  // specified — exactly one plan should have this set; enforced in MembershipsService, not the DB.
  isDefault            Boolean              @default(false)
  status               MembershipPlanStatus @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  memberships BusinessMembership[]
}

enum BusinessMembershipStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

model BusinessMembership {
  id                 String                   @id @default(cuid())
  businessId         String                   @unique
  planId             String
  status             BusinessMembershipStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                   MembershipPlan          @relation(fields: [planId], references: [id])
  subscriptions          Subscription[]
  adminCouponRedemptions AdminCouponRedemption[]
  payments               MembershipPayment[]

  @@index([status])
  @@index([planId])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id           String             @id @default(cuid())
  membershipId String
  periodStart  DateTime
  periodEnd    DateTime
  amount       Decimal            @db.Decimal(12, 2)
  currency     String             @default("USD")
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())

  membership BusinessMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  invoices   Invoice[]
  payments   MembershipPayment[]

  @@index([membershipId])
}

enum MembershipPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// DEPOSIT/TRANSFER are the manual-receipt methods (business uploads proof, admin verifies) — see
// submitPayment. CARD used to be just a label on that same manual flow (owner originally scoped
// out real card-charging); the owner has since asked for a real charge, so CARD now means a real
// Sandbox `Payment` was created/confirmed via PaymentService (see
// MembershipsService.createMembershipCardPayment/confirmMembershipCardPayment) — there is never a
// receiptUrl on a CARD row, only a linked `Payment` (this model's `payment` relation).
enum MembershipPaymentMethod {
  DEPOSIT
  TRANSFER
  CARD
}

// A business's due amount for one membership billing period, and how it got settled. Snapshots
// periodStart/periodEnd/amount at generation/submission time rather than requiring a pre-existing
// Subscription row, because nothing in this codebase auto-generates Subscription rows per billing
// period yet (Subscription/Invoice exist as a schema shape — see MembershipsService's own comment
// — but no rollover engine writes to them). `subscriptionId` is populated once the period is
// actually settled — see MembershipsService.settlePeriod, the one place both a manually-verified
// receipt (verifyPayment) and a successful card charge (confirmMembershipCardPayment) end up, so
// neither duplicates the other's Subscription-creation / currentPeriodStart-End advance / status
// flip. Null while PENDING/REJECTED. Mirrors Refund's PENDING->COMPLETED shape
// (RefundService.completeManual) for the manual-receipt half of this — a business submits, it sits
// PENDING, an admin reviews the receipt image and marks VERIFIED or REJECTED (with a reason).
//
// A row's lifecycle now starts two possible ways (see MembershipPastDueSweeper /
// MembershipsService.submitPayment): (1) auto-generated the moment currentPeriodEnd is reached —
// PENDING, receiptUrl/method both null, dueDate = generatedAt + 5 days; or (2) created directly by
// a proactive submission before the cutoff ever fires — PENDING, receiptUrl/method set immediately,
// dueDate = submittedAt + 5 days. Either way `dueDate` is the one authoritative deadline: once it
// passes with the row still PENDING-without-a-receipt-and-without-a-card-attempt or REJECTED (and
// nothing newer submitted for the same period), the business loses customer-facing visibility —
// see membership-visibility.util.ts — until the period is settled.
model MembershipPayment {
  id              String                   @id @default(cuid())
  membershipId    String
  subscriptionId  String?
  periodStart     DateTime
  periodEnd       DateTime
  amount          Decimal                  @db.Decimal(12, 2)
  currency        String                   @default("USD")
  // Nullable: null until the business actually uploads proof (auto-generated placeholder rows
  // start out this way). Always null on a CARD row — see `payment` below instead.
  receiptUrl      String?
  // Set at submission time for DEPOSIT/TRANSFER (together with receiptUrl), or the moment a card
  // charge is initiated for CARD (see createMembershipCardPayment) — never at auto-generation
  // time, since there is no method until someone actually starts paying.
  method          MembershipPaymentMethod?
  // The single authoritative deadline for this billing period (generatedAt/submittedAt + 5 days).
  // Nullable only for defensiveness against pre-existing rows from before this field existed.
  dueDate         DateTime?
  status          MembershipPaymentStatus  @default(PENDING)
  // The BusinessUser who submitted this proof, or who initiated the card charge — plain id, no
  // relation, same convention as Refund.requestedBy.
  submittedBy     String?
  rejectionReason String?
  // Who settled this row: an admin's id for a manually-verified receipt, or the
  // CARD_AUTO_REVIEWER sentinel (MembershipsService) for a self-service card charge — never
  // blank once VERIFIED, so VERIFIED rows always show how/by-whom in admin history.
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id])
  // The real Sandbox Payment for a CARD charge against this period (see Payment.membershipPaymentId)
  // — null for DEPOSIT/TRANSFER rows and for a not-yet-attempted CARD row.
  payment      Payment?

  @@index([membershipId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  status         InvoiceStatus @default(PENDING)
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationCategory {
  TRANSACTIONAL
  MARKETING
}

// Which app's Notification Center this row belongs in — the same person can be a Customer,
// a Business owner and a Rider on one account (one shared login), so a row is only ever shown
// back in the one app it's actually about (e.g. "your order was paid" is CUSTOMER-only, never
// surfaced in that same person's Business dashboard just because they also own a business).
enum NotificationAudience {
  CUSTOMER
  BUSINESS
  RIDER
  ADMIN
}

model Notification {
  id             String               @id @default(cuid())
  userId         String
  audience       NotificationAudience
  channel        NotificationChannel  @default(IN_APP)
  category       NotificationCategory @default(TRANSACTIONAL)
  event          String
  title          String
  body           String
  entityType     String?
  entityId       String?
  data           Json?
  read           Boolean              @default(false)
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime             @default(now())
  // Deterministic per (recipient, event, entity) — set by NotificationService so the exact same
  // domain event processed twice (retry, duplicate webhook, etc.) collapses into one row instead
  // of paging the recipient N times for the same thing (§2.7/18).
  idempotencyKey String?              @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, audience, read])
  @@index([userId, audience, createdAt])
}

// §10: only MARKETING/PROMOTIONS are ever gated by preference — TRANSACTIONAL notifications
// (orders, deliveries, bookings, system) always fire regardless of these flags, enforced in
// NotificationsService, never left to the frontend to filter.
model NotificationPreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  promotions Boolean  @default(true)
  marketing  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Marketplace economics (Phase 1 settings, Phase 3+ usage) ─────────────────────────────

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

// Configurable weights BusinessRankingService combines into a business's relevanceScore in the
// Marketplace listing — never hardcoded (RULE 13). Append-only history (same pattern as
// Commission below): the latest row by createdAt is the active config, so a weight change is
// itself auditable without a separate AuditLog entry.
model MarketplaceRankingConfig {
  id                 String   @id @default(cuid())
  speciesMatchWeight Float
  distanceWeight     Float
  availabilityWeight Float
  ratingWeight       Float
  deliveryWeight     Float
  updatedBy          String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

model Commission {
  id            String    @id @default(cuid())
  businessId    String
  rate          Decimal   @db.Decimal(5, 4)
  effectiveFrom DateTime  @default(now())
  // Set only on a promotional rate from a redeemed CommissionCoupon — null (every row before this
  // feature existed, and every rate Admin sets normally) means "standard, never expires". Reads of
  // "the current rate" (BusinessesService.getCommissionSummary/listCommissionsForAdmin,
  // ContractsService.buildFeeSnapshot) filter out any row whose expiresAt has passed, so the
  // business automatically reverts to its previous (non-expiring) rate once the promo window
  // ends — no cron/scheduled job needed, same mechanism as RiderCommissionOverride below.
  expiresAt     DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, effectiveFrom])
}

// Per-rider, time-bound override of the platform-wide DeliveryFareConfig.bingoCommissionPercent —
// only ever created by redeeming a CommissionCoupon (targetType RIDER). DeliveryService.complete()
// checks for a live (non-expired) row here for that specific rider before falling back to the
// platform default; expiring naturally reverts the rider with no scheduled job needed.
model RiderCommissionOverride {
  id                     String   @id @default(cuid())
  riderId                String
  bingoCommissionPercent Decimal  @db.Decimal(5, 4)
  effectiveFrom          DateTime @default(now())
  expiresAt              DateTime
  createdAt              DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, effectiveFrom])
}

enum PayeeType {
  BUSINESS
  RIDER
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

// PayoutsService (admin "Pagos"/Payouts module — Businesses & Riders) is the only writer of this
// table. Design: a Payout row is created already PAID, at the moment an admin marks a payee's
// outstanding balance as paid — there's no intermediate PENDING Payout row to generate/manage.
// The "pending total" shown to admin before that is computed live: sum(RiderEarning.netAmount)
// where status=PENDING and payoutId is null (riders), or sum(Order.subtotal) × the business's
// current commission rate for orders that are paid/completed and have payoutId null (businesses).
// Marking paid does two things atomically: (1) creates this row with status PAID/paidAt set, and
// (2) stamps payoutId on every RiderEarning/Order row it covers, so those rows are permanently
// excluded from the next "pending" computation — a row can be swept into a Payout exactly once,
// which is what makes double-paying or losing track of an owed amount structurally impossible
// (no separate "already paid" flag to forget to check, no PENDING Payout that could be paid twice).
model Payout {
  id              String       @id @default(cuid())
  payeeType       PayeeType
  businessId      String?
  riderId         String?
  amount          Decimal      @db.Decimal(12, 2)
  status          PayoutStatus @default(PENDING)
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  // Bank/transfer reference the admin records once the payment actually went out — often not known
  // at the exact moment "Marcar como pagado" is clicked (the transfer may still be in flight), so
  // this is editable after the fact from the Historial tab rather than required up front.
  referenceNumber String?
  createdAt       DateTime     @default(now())

  business      Business?      @relation(fields: [businessId], references: [id])
  rider         Rider?         @relation(fields: [riderId], references: [id])
  riderEarnings RiderEarning[]
  orders        Order[]
  // Card-paid service Bookings swept into this payout (PayoutsService.markBusinessBookingItemsPaid/
  // markBusinessBookingsPaid) — deliberately never mixed with `orders` on the same Payout row: a
  // product-order payout and a service-booking payout are two parallel, separately-triggered
  // actions (services have no Commission rate the way products do — see PayoutsService), so a
  // given Payout's `orders` or `bookings` is always populated, never both.
  bookings      Booking[]

  @@index([payeeType, status])
  @@index([businessId])
  @@index([riderId])
}

// ───────────────────────────── Governance ─────────────────────────────

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id             String        @id @default(cuid())
  orderId        String?
  bookingId      String?
  raisedByUserId String
  type           String
  description    String
  status         DisputeStatus @default(OPEN)
  resolution     String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  order   Order?   @relation(fields: [orderId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
}

// ───────────────────────────── Analytics events (Phase 8) ─────────────────────────────
//
// Lightweight, append-only view/interaction tracking — the only realistic source for "profile
// views"/"coupon views"/"service views" style metrics, which had no tracking at all before this.
// Historical views before this table existed are honestly absent, never backfilled or guessed.

enum AnalyticsEventName {
  BUSINESS_VIEWED
  PRODUCT_VIEWED
  SERVICE_VIEWED
  COUPON_VIEWED
  PROMOTION_VIEWED
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  eventName  AnalyticsEventName
  actorId    String?
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime           @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([eventName, entityId, createdAt])
  @@index([entityType, entityId])
}

// ───────────────────────────── Support (Ayuda) ─────────────────────────────
//
// Two independent flows behind the same "Ayuda" entry point in Customer/Business/Rider:
//   1. SupportCase — "Soporte con la aplicación": a general ticket (code + thread of admin
//      responses), tracked through RECEIVED → IN_PROGRESS → CLOSED.
//   2. SupportChat — "Soporte con un pedido": a short-poll chat tied to one of the submitter's
//      own Order/Delivery/Booking (there is no single unified "pedido" table in this schema, so
//      `relatedType`/`relatedId` stands in for a generic FK rather than three nullable ones), with
//      an admin agent joining live and a 1-5 rating captured when it's closed.
//
// `submitterType`/`submitterUserId` (+ `businessId` when the submitter is a Business) is the same
// shape used to scope every other "me/..." surface — ownership guards below check submitterUserId
// (and, for BUSINESS, membership via BusinessUser) so a Customer/Business/Rider only ever sees
// their own cases/chats, never anyone else's.

enum SupportSubmitterType {
  CUSTOMER
  BUSINESS
  RIDER
}

enum SupportCaseStatus {
  RECEIVED
  IN_PROGRESS
  CLOSED
}

model SupportCase {
  id              String               @id @default(cuid())
  // Human-facing ticket number, e.g. "SUP-000123" — see support-code.util.ts. Never the PK.
  code            String               @unique
  submitterType   SupportSubmitterType
  submitterUserId String
  // Only set when submitterType = BUSINESS — which Business this case was raised from, so
  // BusinessOwnershipGuard-style checks can scope it the same way every other business route does.
  businessId      String?
  subject         String
  description     String
  evidenceUrl     String?
  status          SupportCaseStatus    @default(RECEIVED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  closedAt        DateTime?

  submitter User                  @relation("SupportCaseSubmitter", fields: [submitterUserId], references: [id])
  business  Business?             @relation(fields: [businessId], references: [id])
  responses SupportCaseResponse[]

  @@index([submitterUserId])
  @@index([businessId])
  @@index([status])
}

// Admin-authored replies on a SupportCase's thread (§spec: "admin can respond ... can also upload
// evidence/an image back"). The submitter's own opening message is SupportCase.description itself
// — there is no submitter-side follow-up message in this scope, matching the brief exactly.
model SupportCaseResponse {
  id           String   @id @default(cuid())
  caseId       String
  authorUserId String
  message      String
  evidenceUrl  String?
  createdAt    DateTime @default(now())

  case   SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User        @relation("SupportCaseResponseAuthor", fields: [authorUserId], references: [id])

  @@index([caseId])
}

enum SupportChatRelatedType {
  ORDER
  DELIVERY
  BOOKING
}

enum SupportChatStatus {
  OPEN
  CLOSED
}

model SupportChat {
  id              String                 @id @default(cuid())
  submitterType   SupportSubmitterType
  submitterUserId String
  businessId      String?
  relatedType     SupportChatRelatedType
  relatedId       String
  status          SupportChatStatus      @default(OPEN)
  // Set once any admin opens the chat (first-to-open "picks it up" — simplest reasonable
  // assignment given there's no separate admin-agent queueing system in scope here).
  assignedAdminId String?
  ratingScore     Int?
  ratingComment   String?
  createdAt       DateTime               @default(now())
  closedAt        DateTime?

  submitter     User                 @relation("SupportChatSubmitter", fields: [submitterUserId], references: [id])
  business      Business?            @relation(fields: [businessId], references: [id])
  assignedAdmin User?                @relation("SupportChatAssignedAdmin", fields: [assignedAdminId], references: [id])
  messages      SupportChatMessage[]

  @@index([submitterUserId])
  @@index([businessId])
  @@index([status])
  @@index([relatedType, relatedId])
}

enum SupportChatSenderType {
  CUSTOMER
  BUSINESS
  RIDER
  ADMIN
}

model SupportChatMessage {
  id           String                @id @default(cuid())
  chatId       String
  senderType   SupportChatSenderType
  senderUserId String
  // Nullable, not empty-string — a message is either text, an image, or both, never neither (see
  // SupportChatsService's send methods, which reject a message with both fields blank).
  text         String?
  imageUrl     String?
  createdAt    DateTime              @default(now())
  readAt       DateTime?

  chat   SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User        @relation("SupportChatMessageSender", fields: [senderUserId], references: [id])

  @@index([chatId])
  @@index([chatId, createdAt])
}
